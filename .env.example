# Wypełnij te wartości w `.env.local` (NIE commitujemy `.env.local`).
# Ten plik (`.env.example`) opisuje tylko nazwy zmiennych wymaganych
# do uruchomienia aplikacji — bez wartości produkcyjnych.
# Zgodnie z Wymaganiem 49 (requirements.md, Obszar N).

# URL projektu Supabase (np. https://xxxx.supabase.co). Bezpieczny do ekspozycji w przeglądarce.
NEXT_PUBLIC_SUPABASE_URL=

# Klucz anonimowy (publishable) Supabase — bezpieczny w kodzie klienckim, ograniczony przez RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klucz serwisowy Supabase (service role) — TYLKO serwer. NIGDY nie eksponujemy do przeglądarki ani do bundla klienta.
SUPABASE_SERVICE_ROLE_KEY=

# Klucz Google Maps Embed API — używany do wbudowanych map miejsc/atrakcji.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
